---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const current = trim(Astro.url.pathname);
const target = trim(String(href));
const isCurrent = current === target;
const isActive = isCurrent || (target !== '/' && current.startsWith(target + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isCurrent ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
