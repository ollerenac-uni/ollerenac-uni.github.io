---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('es', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC', // pubDate es medianoche UTC; sin esto, en zonas al oeste de UTC sale el día anterior
	})}
</time>
