---
const today = new Date();
---

<footer>&copy; {today.getFullYear()} cybersecnews · INICTEL-UNI</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		/* --gray da 4.2:1 sobre el tope del degradado; con 20% de negro son 5.9:1 o más. */
		color: color-mix(in srgb, rgb(var(--gray)), black 20%);
		text-align: center;
	}
</style>
